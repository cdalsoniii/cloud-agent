  centerPanel: React.ReactNode;
  rightPanel: React.ReactNode;
}) {
  return (
    <div className="flex h-screen bg-gray-50">
      {/* Left Panel - Navigation/Tree */}
      <div className="w-64 bg-white border-r border-gray-200 flex flex-col">
        <Navbar className="bg-gray-100 border-b border-gray-200">
          <NavbarGroup>
            <NavbarHeading>Navigation</NavbarHeading>
          </NavbarGroup>
        </Navbar>
        <div className="flex-1 overflow-auto">
          {leftPanel}
        </div>
      </div>

      {/* Center Panel - Main Content */}
      <div className="flex-1 flex flex-col min-w-0">
        <Navbar className="bg-white border-b border-gray-200">
          <NavbarGroup>
            <NavbarHeading>Verification Results</NavbarHeading>
          </NavbarGroup>
          <NavbarGroup align="right">
            <ButtonGroup minimal>
              <Button icon="refresh">Refresh</Button>
              <Button icon="export">Export</Button>
              <Button icon="settings">Settings</Button>
            </ButtonGroup>
          </NavbarGroup>
        </Navbar>
        <div className="flex-1 overflow-auto p-4">
          {centerPanel}
        </div>
      </div>

      {/* Right Panel - Inspector/Details */}
      <div className="w-80 bg-white border-l border-gray-200 flex flex-col">
        <Navbar className="bg-gray-100 border-b border-gray-200">
          <NavbarGroup>
            <NavbarHeading>Inspector</NavbarHeading>
          </NavbarGroup>
        </Navbar>
        <div className="flex-1 overflow-auto p-4">
          {rightPanel}
        </div>
      </div>
    </div>
  );
}

