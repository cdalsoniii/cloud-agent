{
  "name": "cloud-agent-handoff",
  "version": "1.0.0",
  "description": "Cloud agent handoff via OpenCode skills and Baseten chain sandbox communication",
  "type": "module",
  "scripts": {
    "deploy-schema": "npx tsx src/deploy-schema.ts",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test dist/**/*.test.js",
    "test:integration": "npx tsx test/integration.test.ts",
    "lint": "eslint src/**/*.ts",
    "handoff": "npx tsx src/cloud-agent-handoff.ts",
    "chain-sandbox": "npx tsx src/baseten-chain-sandbox.ts",
    "orchestrate": "npx tsx src/orchestrator.ts",
    "pr-sandbox": "npx tsx src/pr-sandbox-orchestrator.ts",
    "health": "npx tsx src/health-check.ts",
    "health:openrouter": "npx tsx src/health-check.ts --openrouter-only",
    "smoke:openrouter": "bash scripts/smoke-openrouter.sh",
    "grok": "bash scripts/grok-with-openrouter.sh",
    "mastra:daytona": "npx tsx src/mastra/index.ts",
    "mastra:verify": "npx tsx src/mastra/tools/verify-rules.ts",
    "mastra:mcp": "bash scripts/run-mastra-mcp.sh",
    "mastra:mcp:sse": "MCP_TRANSPORT=sse bash scripts/run-mastra-mcp.sh",
    "baseten-proxy": "node baseten-proxy.js",
    "gateway": "node gateway.js",
    "verify-data": "npx tsx src/verify-data-loading.ts",
    "sync:opencode": "npx tsx src/sync-opencode-to-surreal.ts",
    "logs:sync": "npx tsx src/sync-sandbox-logs.ts",
    "logs:verify": "npx tsx src/sync-sandbox-logs.ts --verify",
    "previews:mint": "npx tsx scripts/mint-formal-previews.ts",
    "previews:refresh": "npx tsx scripts/mint-formal-previews.ts --refresh",
    "previews:watch": "npx tsx scripts/mint-formal-previews.ts --watch --interval 120 --ticks 30",
    "sandbox:opencode": "npx tsx scripts/demo-formal-opencode.ts",
    "sandbox:health": "npx tsx scripts/demo-formal-opencode.ts",
    "federation:push": "bash scripts/push-schema-federation.sh",
    "federation:push:restart": "bash scripts/push-schema-federation.sh --restart",
    "api:sessions": "npx tsx src/session-api.ts",
    "validation:test": "npx tsx test-validation.ts",
    "validation:run": "npx tsx src/validation/run-validation.ts",
    "mastra:mcp:test": "npx tsx scripts/test-mastra-mcp.mjs",
    "verify:quint": "bash scripts/verify-local.sh --suite quint",
    "verify:dafny": "bash scripts/verify-local.sh --suite dafny",
    "verify:alloy": "bash scripts/verify-local.sh --suite alloy",
    "verify:all": "bash scripts/verify-local.sh --suite all",
    "verify:tools": "bash scripts/verify-local.sh --check-tools",
    "verify:setup": "bash scripts/setup-verification-tools.sh",
    "smoke:formal": "bash scripts/smoke-formal-happy-path.sh",
    "smoke:shacl-sandbox": "npx tsx scripts/smoke-shacl-sandbox.ts",
    "smoke:oteemo-shacl": "npx tsx scripts/smoke-oteemo-shacl-pipeline.ts",
    "smoke:oteemo-cascade": "npx tsx scripts/smoke-oteemo-validation-cascade.ts",
    "smoke:oteemo-hook-context": "npx tsx scripts/smoke-oteemo-hook-context.ts",
    "smoke:oteemo-hook-context:live": "VERIFIER_LIVE=1 npx tsx scripts/smoke-oteemo-hook-context-live.ts",
    "smoke:mcp-tool-surface": "npx tsx scripts/smoke-mcp-tool-surface.ts",
    "smoke:io-enforcement": "npx tsx scripts/smoke-io-enforcement.ts",
    "smoke:linkml-reasoning": "npx tsx scripts/smoke-linkml-reasoning.ts",
    "smoke:validation-io-surreal": "npx tsx scripts/smoke-validation-io-surreal.ts",
    "open:linkml-verifiers": "npx tsx scripts/open-linkml-verifiers.ts",
    "playwright:local-aui-fleet": "bash scripts/playwright-local-aui-fleet.sh",
    "probe:opencode": "npx tsx scripts/probe-opencode-host.ts",
    "probe:formal-surfaces": "bash scripts/probe-formal-surfaces.sh",
    "test:hook-context": "npx tsx --test src/verification-sandbox/ontology-hook-context.test.ts",
    "test:io-enforcement": "npx tsx --test src/verification-sandbox/io-enforcement.test.ts",
    "test:linkml-reasoning": "npx tsx --test src/verification-sandbox/linkml-reasoning.test.ts",
    "test:ontology-panel": "npx tsx --test src/verification-sandbox/ontology-panel-state.test.ts",
    "test:ontology-overlay": "npx tsx --test src/verification-sandbox/ontology-overlay.test.ts",
    "test:ontology-budget": "npx tsx --test src/verification-sandbox/ontology-budget.test.ts",
    "test:guardrails-servers": "npx tsx --test src/verification-sandbox/guardrails-servers.test.ts",
    "test:midspiral-bridge": "npx tsx --test src/verification-sandbox/midspiral-bridge.test.ts",
    "smoke:ontology-ui": "npx tsx scripts/smoke-ontology-ui.ts",
    "smoke:ontology-mode": "npx tsx scripts/smoke-ontology-mode.ts",
    "smoke:sandbox-zones": "npx tsx scripts/smoke-sandbox-zones.ts",
    "demo:customers": "npx tsx scripts/demo-example-customers.ts",
    "demo:formal-ui": "npx tsx scripts/demo-formal-ui.ts",
    "lean:bridge": "node scripts/lean-live-bridge.mjs",
    "lean:smoke": "bash scripts/smoke-grok-lean.sh",
    "lean:surreal": "bash scripts/lean-surreal-validate.sh",
    "lean:surreal:graphql": "npx tsx scripts/lean-surreal-graphql.ts",
    "lean:surreal:export": "npx tsx scripts/lean-surreal-export.ts",
    "grok:lean": "bash scripts/grok-lean-split.sh",
    "grok:stack": "bash scripts/lean-stack.sh start && bash scripts/lean-live-bridge.sh start",
    "claude:lean": "bash scripts/claude-lean-split.sh",
    "claude:openrouter": "bash scripts/claude-openrouter.sh",
    "opencode:lean": "bash scripts/opencode-lean-split.sh",
    "prd:plan": "tsx src/formal-prd-planner.ts",
    "test:prd": "tsx --test src/formal-prd/formal-prd.test.ts",
    "opencode:milestone": "tsx scripts/opencode-sdk-milestone.ts",
    "opencode:milestone:dry": "tsx scripts/opencode-sdk-milestone.ts --mode dry-run",
    "opencode:milestone:listen": "tsx scripts/opencode-sdk-milestone.ts --mode listen",
    "opencode:milestone:daytona": "tsx scripts/opencode-sdk-milestone.ts --mode daytona",
    "formal:expand-web": "tsx scripts/expand-web-formal-daytona.ts",
    "gsd:baseten": "bash scripts/gsd-baseten-drive.sh",
    "gsd:baseten:query": "bash scripts/gsd-baseten-drive.sh query",
    "gsd:baseten:status": "bash scripts/gsd-baseten-drive.sh status"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.20",
    "@daytona/sdk": "^0.199.0",
    "@mastra/core": "^0.1.26",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/sdk": "^1.18.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "dotenv": "^16.4.5",
    "node-fetch": "^3.3.2",
    "surqlize": "^0.1.0",
    "surrealdb": "^2.0.8",
    "surrealdb-orm": "^1.8.9",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^8.57.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
